# Adresse et clé publique du projet Supabase
# (Supabase → Project Settings → API). La clé « anon » est faite pour être
# publique : la sécurité est assurée par les règles de la base.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Facultatif : clé secrète Supabase (Settings > API keys > secret / service_role).
# Confirme d’office l’identité d’un dirigeant dont le nom figure au registre.
SUPABASE_SERVICE_ROLE_KEY=
